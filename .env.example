# ─── Supabase ────────────────────────────────────────────────────────────────
# Dari Project Settings > API di dashboard Supabase kamu.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key
# Service role key: HANYA dipakai server-side (API route /api/admin & script
# provisioning). JANGAN beri prefix NEXT_PUBLIC_ — kalau bocor ke browser,
# RLS bisa di-bypass sepenuhnya.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── EmailJS (https://emailjs.com) ───────────────────────────────────────────
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_FROM_EMAIL=your_sender@gmail.com
NEXT_PUBLIC_EMAILJS_NOTIFY_EMAIL=notify_target@email.com
NEXT_PUBLIC_EMAILJS_ENABLED=true
