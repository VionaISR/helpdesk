:root {
  --bg: #fafafa;
  --surface: #ffffff;
  --surface-2: #f5f5f5;
  --border: #e5e5e5;
  --border-strong: #d4d4d4;
  --text: #18181b;
  --text-muted: #71717a;
  --text-subtle: #a1a1aa;
  --accent: #18181b;
  --accent-hover: #27272a;

  --status-open: #2563eb;
  --status-open-bg: #eff6ff;
  --status-progress: #d97706;
  --status-progress-bg: #fffbeb;
  --status-pending: #7c3aed;
  --status-pending-bg: #f5f3ff;
  --status-revisi: #c2410c;
  --status-revisi-bg: #fff7ed;
  --status-done: #16a34a;
  --status-done-bg: #f0fdf4;
  --status-resolved: #16a34a;
  --status-resolved-bg: #f0fdf4;
  --status-closed: #525252;
  --status-closed-bg: #f4f4f5;

  --priority-low: #6b7280;
  --priority-medium: #ca8a04;
  --priority-high: #ea580c;
  --priority-critical: #dc2626;

  --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --mono: 'JetBrains Mono', monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  font-family: var(--sans);
  font-size: 14px;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; font-size: inherit; }
input, textarea, select { font-family: inherit; font-size: inherit; color: inherit; outline: none; }
a { color: inherit; text-decoration: none; }

.mono { font-family: var(--mono); font-size: 12px; }

/* === BUTTONS === */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 6px;
  font-weight: 500;
  font-size: 13px;
  transition: all 0.15s ease;
  white-space: nowrap;
}
.btn-primary { background: var(--accent); color: white; }
.btn-primary:hover { background: var(--accent-hover); }
.btn-secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
.btn-secondary:hover { background: var(--surface-2); border-color: var(--border-strong); }
.btn-ghost { color: var(--text-muted); padding: 6px 10px; }
.btn-ghost:hover { color: var(--text); background: var(--surface-2); }
.btn-sm { padding: 6px 10px; font-size: 12px; }

/* === INPUTS === */
.input, .textarea, .select {
  width: 100%;
  padding: 8px 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  color: var(--text);
  transition: border-color 0.15s ease;
}
.input:focus, .textarea:focus, .select:focus { border-color: var(--text); }
.textarea { min-height: 100px; resize: vertical; font-family: inherit; }
.label { display: block; font-size: 12px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
.field { margin-bottom: 16px; }
.field-hint { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

/* === BADGES === */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.4;
}
.badge-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

.status-open { background: var(--status-open-bg); color: var(--status-open); }
.status-open .badge-dot { background: var(--status-open); }
.status-progress { background: var(--status-progress-bg); color: var(--status-progress); }
.status-progress .badge-dot { background: var(--status-progress); }
.status-pending { background: var(--status-pending-bg); color: var(--status-pending); }
.status-pending .badge-dot { background: var(--status-pending); }
.status-revisi { background: var(--status-revisi-bg); color: var(--status-revisi); }
.status-revisi .badge-dot { background: var(--status-revisi); }
.status-done { background: var(--status-done-bg); color: var(--status-done); }
.status-done .badge-dot { background: var(--status-done); }
.status-resolved { background: var(--status-resolved-bg); color: var(--status-resolved); }
.status-resolved .badge-dot { background: var(--status-resolved); }
.status-closed { background: var(--status-closed-bg); color: var(--status-closed); }
.status-closed .badge-dot { background: var(--status-closed); }

.priority { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 500; }
.priority-bar { width: 3px; height: 12px; border-radius: 2px; }
.priority-low .priority-bar { background: var(--priority-low); }
.priority-low { color: var(--priority-low); }
.priority-medium .priority-bar { background: var(--priority-medium); }
.priority-medium { color: var(--priority-medium); }
.priority-high .priority-bar { background: var(--priority-high); }
.priority-high { color: var(--priority-high); }
.priority-critical .priority-bar { background: var(--priority-critical); }
.priority-critical { color: var(--priority-critical); }

/* === CARDS === */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
.card-header { padding: 16px 20px; border-bottom: 1px solid var(--border); }
.card-body { padding: 20px; }
.card-title { font-size: 14px; font-weight: 600; color: var(--text); }
.card-subtitle { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

/* === TABLES === */
.table { width: 100%; border-collapse: collapse; }
.table th {
  text-align: left;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-muted);
  padding: 10px 16px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
}
.table td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
.table tr:hover td { background: var(--surface-2); cursor: pointer; }
.table tr:last-child td { border-bottom: none; }

/* === LAYOUT === */
.app { display: flex; min-height: 100vh; }
.sidebar { width: 240px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; flex-shrink: 0; }
.sidebar-header { padding: 20px 20px 16px; border-bottom: 1px solid var(--border); }
.sidebar-title { font-size: 13px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
.sidebar-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
.sidebar-nav { flex: 1; padding: 12px; overflow-y: auto; }
.nav-section { margin-bottom: 20px; }
.nav-section-title { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-subtle); padding: 0 8px 8px; }
.nav-item { display: flex; align-items: center; justify-content: space-between; padding: 7px 10px; border-radius: 5px; font-size: 13px; color: var(--text-muted); margin-bottom: 1px; transition: all 0.1s ease; cursor: pointer; }
.nav-item:hover { background: var(--surface-2); color: var(--text); }
.nav-item.active { background: var(--surface-2); color: var(--text); font-weight: 500; }
.nav-count { font-size: 11px; color: var(--text-subtle); font-family: var(--mono); }
.sidebar-footer { padding: 12px; border-top: 1px solid var(--border); }
.user-card { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 6px; }
.user-card:hover { background: var(--surface-2); }
.user-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; flex-shrink: 0; }
.user-name { font-size: 12px; font-weight: 500; color: var(--text); }
.user-role { font-size: 11px; color: var(--text-muted); }

.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.topbar { height: 56px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; flex-shrink: 0; }
.topbar-title { font-size: 14px; font-weight: 600; }
.topbar-breadcrumb { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
.topbar-actions { display: flex; align-items: center; gap: 8px; }
.content { flex: 1; overflow-y: auto; padding: 24px; }

/* === MODAL === */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 24px; }
.modal { background: var(--surface); border-radius: 8px; width: 100%; max-width: 560px; max-height: 90vh; overflow-y: auto; box-shadow: 0 24px 60px rgba(0,0,0,0.18); }
.modal-header { padding: 18px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.modal-title { font-size: 15px; font-weight: 600; }
.modal-subtitle { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.modal-body { padding: 20px; }
.modal-footer { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }

/* === STATS === */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 24px; }
.stat { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }
.stat-label { font-size: 12px; color: var(--text-muted); margin-bottom: 6px; }
.stat-value { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
.stat-trend { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.stat-trend.up { color: #16a34a; }
.stat-trend.down { color: #dc2626; }

/* === EMPTY === */
.empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
.empty-title { font-size: 14px; font-weight: 500; color: var(--text); margin-bottom: 4px; }
.empty-sub { font-size: 13px; }

/* === FILTERS === */
.filters { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
.filter-input { width: 240px; padding: 7px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; }
.filter-select { padding: 7px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; color: var(--text); }

/* === COMMENT === */
.comment { padding: 14px 0; border-bottom: 1px solid var(--border); }
.comment:last-child { border-bottom: none; }
.comment-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.comment-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--surface-2); color: var(--text); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; }
.comment-name { font-size: 13px; font-weight: 600; }
.comment-time { font-size: 11px; color: var(--text-muted); }
.comment-body { font-size: 13px; color: var(--text); line-height: 1.6; padding-left: 38px; }

/* === SLA BAR === */
.sla-bar { height: 4px; background: var(--surface-2); border-radius: 2px; overflow: hidden; margin-top: 4px; }
.sla-fill { height: 100%; border-radius: 2px; transition: width 0.3s ease; }
.sla-ok { background: #16a34a; }
.sla-warn { background: #d97706; }
.sla-breach { background: #dc2626; }

/* === KB === */
.kb-list { display: flex; flex-direction: column; gap: 8px; }
.kb-item { padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; transition: all 0.15s ease; }
.kb-item:hover { border-color: var(--text); cursor: pointer; }
.kb-title { font-size: 14px; font-weight: 500; margin-bottom: 4px; }
.kb-meta { font-size: 11px; color: var(--text-muted); display: flex; gap: 12px; }

/* === HUB === */
.hub { max-width: 1100px; margin: 0 auto; padding: 80px 32px; }
.hub-eyebrow { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 16px; }
.hub-title { font-size: 40px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 12px; max-width: 600px; }
.hub-lede { font-size: 15px; color: var(--text-muted); max-width: 560px; line-height: 1.6; margin-bottom: 48px; }
.hub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.hub-card { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 24px; transition: all 0.15s ease; }
.hub-card:hover { border-color: var(--text); transform: translateY(-2px); }
.hub-card-num { font-family: var(--mono); font-size: 11px; color: var(--text-subtle); margin-bottom: 24px; }
.hub-card-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
.hub-card-desc { font-size: 13px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
.hub-card-meta { font-family: var(--mono); font-size: 10px; color: var(--text-subtle); text-transform: uppercase; letter-spacing: 0.05em; padding-top: 14px; border-top: 1px solid var(--border); }
.hub-footer { margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text-muted); display: flex; justify-content: space-between; }

/* =========================================================================
   SPICEWORKS-STYLE PIC DASHBOARD
   ========================================================================= */
.sw-app { display: flex; flex-direction: column; min-height: 100vh; background: #1a1a2e; color: #e0e0e0; font-size: 13px; }
.sw-topbar { display: flex; align-items: center; padding: 0 16px; height: 44px; background: #0f0f1a; border-bottom: 1px solid #2a2a3e; flex-shrink: 0; gap: 0; }
.sw-logo { font-size: 13px; font-weight: 600; color: #f97316; margin-right: 32px; white-space: nowrap; }
.sw-nav { display: flex; gap: 4px; flex: 1; }
.sw-nav-link { padding: 6px 12px; border-radius: 4px; font-size: 12px; color: #a0a0b0; cursor: pointer; transition: all 0.1s; }
.sw-nav-link:hover { background: #1e1e32; color: #e0e0e0; }
.sw-nav-link.active { background: #f97316; color: #fff; font-weight: 500; }
.sw-topbar-right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
.sw-btn-icon { background: none; border: none; font-size: 14px; cursor: pointer; padding: 4px 6px; border-radius: 4px; color: #a0a0b0; }
.sw-btn-icon:hover { background: #1e1e32; }
.sw-secondbar { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; background: #f97316; min-height: 40px; }
.sw-secondbar-inner { display: flex; align-items: center; gap: 8px; }
.sw-secondbar-title { font-size: 12px; font-weight: 500; color: #fff; }
.sw-sep { color: rgba(255,255,255,0.5); font-size: 12px; }
.sw-secondbar-page { font-size: 12px; color: rgba(255,255,255,0.8); }
.sw-btn-primary { display: flex; align-items: center; gap: 6px; padding: 7px 14px; background: #fff; color: #f97316; border: none; border-radius: 4px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s; }
.sw-btn-primary:hover { background: #fff5eb; }
.sw-body { display: flex; flex: 1; overflow: hidden; height: calc(100vh - 84px); }
.sw-sidebar { width: 200px; background: #16162a; border-right: 1px solid #2a2a3e; overflow-y: auto; flex-shrink: 0; padding: 8px 0; }
.sw-sidebar-section { margin-bottom: 16px; }
.sw-sidebar-section-title { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; padding: 8px 12px 6px; }
.sw-sidebar-item { display: flex; align-items: center; justify-content: space-between; padding: 7px 12px; font-size: 12px; color: #a0a0b0; cursor: pointer; transition: all 0.1s; border-left: 3px solid transparent; }
.sw-sidebar-item:hover { background: #1e1e32; color: #e0e0e0; }
.sw-sidebar-item.active { background: #1e1e32; color: #f97316; border-left-color: #f97316; font-weight: 500; }
.sw-sidebar-item.is-team.active { color: #60a5fa; border-left-color: #60a5fa; }
.sw-count { font-size: 11px; font-family: 'JetBrains Mono', monospace; color: #6b7280; background: #1e1e32; padding: 1px 6px; border-radius: 3px; }
.sw-list-pane { width: 380px; background: #1a1a2e; border-right: 1px solid #2a2a3e; display: flex; flex-direction: column; flex-shrink: 0; }
.sw-list-toolbar { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #2a2a3e; background: #16162a; }
.sw-search { flex: 1; padding: 7px 12px; background: #0f0f1a; border: 1px solid #2a2a3e; border-radius: 4px; color: #e0e0e0; font-size: 12px; font-family: inherit; }
.sw-search::placeholder { color: #6b7280; }
.sw-search:focus { border-color: #f97316; outline: none; }
.sw-toolbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.sw-filter-group { display: flex; gap: 4px; }
.sw-select-sm { padding: 6px 8px; background: #0f0f1a; border: 1px solid #2a2a3e; border-radius: 4px; color: #a0a0b0; font-size: 11px; font-family: inherit; cursor: pointer; }
.sw-pagination { font-size: 11px; color: #6b7280; white-space: nowrap; }
.sw-list { flex: 1; overflow-y: auto; }
.sw-list::-webkit-scrollbar { width: 6px; }
.sw-list::-webkit-scrollbar-thumb { background: #2a2a3e; border-radius: 3px; }
.sw-list-item { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid #1e1e32; cursor: pointer; transition: background 0.1s; }
.sw-list-item:hover { background: #1e1e32; }
.sw-list-item.selected { background: #1e1e32; border-left: 3px solid #f97316; }
.sw-list-item-left { display: flex; align-items: flex-start; gap: 10px; flex: 1; min-width: 0; }
.sw-status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
.sw-status-dot.status-open { background: #3b82f6; }
.sw-status-dot.status-in-progress { background: #f97316; }
.sw-status-dot.status-pending { background: #a855f7; }
.sw-status-dot.status-revisi { background: #f97316; }
.sw-status-dot.status-done { background: #22c55e; }
.sw-status-dot.status-closed { background: #6b7280; }
.sw-list-item-info { flex: 1; min-width: 0; }
.sw-list-item-subject { font-size: 12px; font-weight: 500; color: #e0e0e0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 3px; }
.sw-list-item-meta { display: flex; align-items: center; gap: 5px; font-size: 11px; color: #6b7280; flex-wrap: wrap; }
.sw-list-id { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #4b5563; }
.sw-list-dot { color: #4b5563; }
.sw-list-from { color: #9ca3af; }
.sw-list-time { color: #6b7280; }
.sw-list-item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.sw-app-badge { font-size: 10px; color: #60a5fa; background: rgba(96,165,250,0.1); padding: 2px 6px; border-radius: 3px; white-space: nowrap; }
.sw-unassigned-badge { font-size: 10px; color: #f97316; background: rgba(249,115,22,0.1); padding: 2px 6px; border-radius: 3px; }
.sw-assignee-mini { display: flex; align-items: center; }
.sw-avatar-sm { width: 24px; height: 24px; border-radius: 50%; background: #f97316; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; }
.sw-detail-pane { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #0f0f1a; min-width: 0; }
.sw-ticket-detail { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
.sw-detail-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: #16162a; border-bottom: 1px solid #2a2a3e; flex-shrink: 0; gap: 12px; }
.sw-detail-header-left { display: flex; align-items: baseline; gap: 10px; min-width: 0; flex: 1; }
.sw-detail-id { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #6b7280; white-space: nowrap; }
.sw-detail-subject { font-size: 13px; font-weight: 600; color: #e0e0e0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sw-detail-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.sw-btn-accept { padding: 5px 12px; background: #22c55e; color: #fff; border: none; border-radius: 4px; font-size: 12px; font-weight: 600; cursor: pointer; }
.sw-btn-accept:hover { background: #16a34a; }
.sw-btn-done { padding: 5px 12px; background: #2563eb; color: #fff; border: none; border-radius: 4px; font-size: 12px; font-weight: 600; cursor: pointer; }
.sw-btn-done:hover { background: #1d4ed8; }
.sw-assigned-to-me { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #22c55e; font-weight: 500; padding: 5px 10px; background: rgba(34,197,94,0.1); border-radius: 4px; }
.sw-check { font-weight: 700; }
.sw-btn-more, .sw-btn-info, .sw-btn-x { padding: 5px 8px; background: none; border: none; color: #6b7280; font-size: 14px; cursor: pointer; border-radius: 3px; }
.sw-btn-more:hover, .sw-btn-info:hover { background: #2a2a3e; color: #e0e0e0; }
.sw-btn-x { color: #ef4444; }
.sw-btn-x:hover { background: #2a2a3e; }
.sw-detail-content { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
.sw-detail-content::-webkit-scrollbar { width: 6px; }
.sw-detail-content::-webkit-scrollbar-thumb { background: #2a2a3e; border-radius: 3px; }
.sw-ticket-body-block { padding: 16px; border-bottom: 1px solid #1e1e32; }
.sw-ticket-from { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.sw-ticket-from-name { font-size: 13px; font-weight: 600; color: #e0e0e0; }
.sw-ticket-from-email { font-size: 11px; color: #6b7280; }
.sw-ticket-body { background: #1e1e32; border-radius: 6px; padding: 12px 14px; font-size: 12px; line-height: 1.6; color: #d1d5db; border-left: 3px solid #f97316; word-break: break-word; overflow-wrap: break-word; }
.sw-activity-feed { padding: 12px 16px; border-bottom: 1px solid #1e1e32; background: #141425; }
.sw-activity-toggle { font-size: 11px; color: #6b7280; background: none; border: none; cursor: pointer; padding: 0; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
.sw-activity-toggle:hover { color: #e0e0e0; }
.sw-activity-item { display: flex; gap: 10px; padding: 6px 0; border-bottom: 1px solid #1a1a2e; }
.sw-activity-item:last-child { border-bottom: none; }
.sw-activity-icon { font-size: 12px; flex-shrink: 0; }
.sw-activity-body { flex: 1; }
.sw-activity-text { font-size: 12px; color: #9ca3af; }
.sw-activity-time { font-size: 10px; color: #4b5563; margin-top: 2px; }
.sw-internal-tag { display: inline-block; font-size: 9px; padding: 1px 6px; background: #f97316; color: #fff; border-radius: 3px; font-weight: 600; text-transform: uppercase; margin-left: 6px; }
.sw-comments { padding: 12px 16px; }
.sw-no-comments { font-size: 12px; color: #4b5563; padding: 8px 0; }
.sw-comment { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #1e1e32; }
.sw-comment:last-child { border-bottom: none; margin-bottom: 0; }
.sw-comment.sw-comment-internal { opacity: 0.75; border-left: 3px solid #f97316; padding-left: 10px; margin-left: -13px; }
.sw-comment-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.sw-comment-av { width: 28px; height: 28px; border-radius: 50%; background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; flex-shrink: 0; }
.sw-comment-name { font-size: 12px; font-weight: 600; color: #e0e0e0; }
.sw-comment-time { font-size: 10px; color: #6b7280; }
.sw-comment-body { font-size: 12px; color: #d1d5db; line-height: 1.5; margin-left: 36px; }
.sw-comment-box { padding: 12px 16px; border-top: 1px solid #2a2a3e; background: #16162a; flex-shrink: 0; }
.sw-comment-type-toggle { margin-bottom: 8px; }
.sw-toggle-label { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #a0a0b0; cursor: pointer; }
.sw-comment-input { width: 100%; padding: 8px 12px; background: #0f0f1a; border: 1px solid #2a2a3e; border-radius: 5px; color: #e0e0e0; font-size: 12px; font-family: inherit; resize: none; min-height: 70px; transition: border-color 0.15s; }
.sw-comment-input:focus { border-color: #f97316; outline: none; }
.sw-comment-toolbar { display: flex; align-items: center; gap: 4px; margin-top: 6px; }
.sw-btn-tool { padding: 4px 7px; background: none; border: 1px solid #2a2a3e; border-radius: 3px; font-size: 12px; color: #6b7280; cursor: pointer; }
.sw-btn-tool:hover { background: #2a2a3e; color: #e0e0e0; }
.sw-btn-sm { padding: 5px 10px; font-size: 11px; }
.sw-user-avatar { width: 28px; height: 28px; border-radius: 50%; background: #f97316; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; cursor: pointer; }
.sw-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; color: #6b7280; }
.sw-empty-icon { font-size: 32px; margin-bottom: 12px; }
.sw-empty-title { font-size: 13px; font-weight: 600; color: #a0a0b0; margin-bottom: 4px; }
.sw-empty-sub { font-size: 12px; color: #6b7280; text-align: center; }
.sw-ai-result { background: #1e1e32; border: 1px solid #2a2a3e; border-radius: 6px; overflow: hidden; }
.sw-ai-result-item { display: flex; align-items: center; justify-content: space-between; padding: 7px 12px; border-bottom: 1px solid #2a2a3e; font-size: 12px; }
.sw-ai-result-item:last-child { border-bottom: none; }
.sw-ai-result-item span:first-child { color: #6b7280; }
.sw-ai-result-item span:last-child { color: #e0e0e0; font-weight: 500; }
.sw-select-full { width: 100%; padding: 6px 8px; background: #0f0f1a; border: 1px solid #2a2a3e; border-radius: 4px; color: #e0e0e0; font-size: 12px; font-family: inherit; cursor: pointer; }
.sw-select-full:focus { border-color: #f97316; outline: none; }
.sw-list-pane { min-width: 0; }
.sw-list-toolbar { flex-wrap: wrap; }
.sw-toolbar-right { flex-wrap: wrap; }

/* === LOGIN === */
.login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg); padding: 24px; }
.login-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 40px 36px; width: 100%; max-width: 400px; box-shadow: 0 8px 32px rgba(0,0,0,0.06); }
.login-logo { font-size: 32px; margin-bottom: 16px; }
.login-title { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px; }
.login-subtitle { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; line-height: 1.5; }
.login-form { margin-bottom: 20px; }
.login-error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 6px; padding: 10px 12px; font-size: 12px; margin-bottom: 14px; }
.login-hint-toggle { font-size: 12px; color: var(--text-muted); cursor: pointer; text-align: center; padding: 8px; border-radius: 6px; transition: background 0.1s; }
.login-hint-toggle:hover { background: var(--surface-2); color: var(--text); }
.login-hints { margin-top: 12px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
.login-hints-label { font-size: 10px; color: var(--text-subtle); padding: 8px 12px 4px; text-transform: uppercase; letter-spacing: 0.04em; }
.login-hint-item { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 12px; border: none; background: none; text-align: left; cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.1s; font-family: inherit; }
.login-hint-item:last-child { border-bottom: none; }
.login-hint-item:hover { background: var(--surface); }
.login-hint-role { font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; flex-shrink: 0; text-transform: uppercase; letter-spacing: 0.04em; }
.login-hint-name { font-size: 12px; font-weight: 500; color: var(--text); }
.login-hint-email { font-size: 11px; color: var(--text-muted); }

/* =========================================================================
   RESPONSIVE
   ========================================================================= */
@media (max-width: 1100px) {
  .sw-list-pane { width: 300px; }
  .sw-sidebar { width: 170px; }
  .hub-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 900px) {
  .app { flex-direction: column; }
  .sidebar { width: 100% !important; flex-direction: row; height: auto; flex-shrink: 0; overflow-x: auto; }
  .sidebar-nav { display: flex; flex-direction: row; padding: 4px 8px; overflow-x: auto; }
  .nav-section { display: flex; flex-direction: row; gap: 2px; margin: 0 8px 0 0; }
  .nav-section-title { display: none; }
  .nav-item { white-space: nowrap; padding: 6px 10px; }
  .sidebar-footer { display: none; }
  .sidebar-header { padding: 12px 16px; border-right: 1px solid var(--border); border-bottom: none; }
  .sw-body { flex-direction: column; height: auto; overflow: visible; }
  .sw-sidebar { width: 100% !important; flex-direction: row; overflow-x: auto; padding: 4px 0; border-right: none; border-bottom: 1px solid #2a2a3e; height: auto; }
  .sw-sidebar-section { display: flex; flex-direction: row; align-items: center; margin: 0; padding: 0 4px; }
  .sw-sidebar-section-title { display: none; }
  .sw-sidebar-item { white-space: nowrap; border-left: none; border-bottom: 3px solid transparent; }
  .sw-sidebar-item.active { border-left-color: transparent; border-bottom-color: #f97316; }
  .sw-list-pane { width: 100% !important; max-height: 300px; }
  .sw-detail-pane { min-height: 400px; }
  .sw-body { height: auto !important; }
}

@media (max-width: 700px) {
  .modal { margin: 0 12px; }
  .sw-nav { display: none; }
  .sw-topbar { flex-wrap: wrap; height: auto; padding: 8px 12px; gap: 8px; }
  .card { overflow-x: auto; }
  .table { min-width: 560px; }
  .hub { padding: 40px 16px; }
  .hub-title { font-size: 26px; }
  .hub-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .login-card { padding: 28px 20px; }
  .modal-overlay { padding: 12px; }
  .sw-detail-header { flex-direction: column; align-items: flex-start; gap: 8px; }
  .sw-detail-actions { flex-wrap: wrap; }
  .content { padding: 16px; }
  .topbar { padding: 0 16px; }
  .stat-grid { grid-template-columns: 1fr 1fr; }
  .sw-list-toolbar { flex-direction: column; align-items: stretch; }
  .sw-search { width: 100%; }
  .sw-filter-group { flex-wrap: wrap; }
}

/* =========================================================================
   PRINT
   ========================================================================= */
@media print {
  @page { margin: 14mm 12mm; }
  body { background: #fff !important; color: #000 !important; font-size: 11px; }
  .no-print, .sidebar, .topbar, button, .btn { display: none !important; }
  .app, .main { display: block !important; margin-left: 0 !important; }
  .content { padding: 0 !important; overflow: visible !important; }
  .stat-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 8px !important; }
  .card { break-inside: avoid; border: 1px solid #d0d0d0 !important; box-shadow: none !important; }
  .table th { background: #f0f0f0 !important; color: #333 !important; font-size: 9px !important; padding: 5px 8px !important; border: 1px solid #ccc !important; }
  .table td { border: 1px solid #e0e0e0 !important; padding: 4px 8px !important; font-size: 10px !important; }
  .badge { display: inline-block !important; padding: 2px 7px !important; font-size: 9px !important; border: 1px solid currentColor !important; }
  .badge-dot { display: none !important; }
  .cutoff-print-header { display: block !important; margin-bottom: 18px; }
}
