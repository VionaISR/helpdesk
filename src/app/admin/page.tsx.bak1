'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { getSession, logout } from '@/lib/auth';
import { ticketStore } from '@/lib/store';
import { appRulesStore, type AppPICRule } from '@/lib/app-rules';
import { userStore } from '@/lib/user-store';
import { teams, pics, categories, apps, specificTasks, kbArticles, sla, sampleUsers } from '@/lib/data';
import { formatDate, statusClass, slaProgress } from '@/lib/utils';
import type { Ticket, Session } from '@/types';

function NavItem({ label, count, active, onClick }: { label: string; count?: number; active: boolean; onClick: () => void }) {
  return (
    <a className={`nav-item${active?' active':''}`} onClick={onClick}>
      <span>{label}</span>
      {count !== undefined && <span className="nav-count">{count}</span>}
    </a>
  );
}

// ─── DASHBOARD PAGE ────────────────────────────────────────────────────────────
function DashboardPage({ tickets }: { tickets: Ticket[] }) {
  const totalTickets = tickets.length;
  const openTickets = tickets.filter(t => ['Open','In Progress','Pending','Revisi'].includes(t.status)).length;
  const slaBreaches = tickets.filter(t => slaProgress(t.createdAt, t.slaDeadline).breached && ['Open','In Progress','Pending','Revisi'].includes(t.status)).length;
  const categoryVolume = categories.map(c => ({ ...c, count: tickets.filter(t => t.category === c.id).length }));
  const maxVolume = Math.max(...categoryVolume.map(c => c.count), 1);
  const weeklyData = [{ day:'Sen',count:4 },{ day:'Sel',count:7 },{ day:'Rab',count:5 },{ day:'Kam',count:9 },{ day:'Jum',count:6 },{ day:'Sab',count:2 },{ day:'Min',count:1 }];
  const maxDay = Math.max(...weeklyData.map(d => d.count));

  return (
    <div>
      <div className="stat-grid">
        <div className="stat"><div className="stat-label">Total tiket</div><div className="stat-value">{totalTickets}</div><div className="stat-trend up">+12% dari bulan lalu</div></div>
        <div className="stat"><div className="stat-label">Tiket aktif</div><div className="stat-value">{openTickets}</div><div className="stat-trend">Sedang ditangani</div></div>
        <div className="stat"><div className="stat-label">SLA compliance</div><div className="stat-value">94%</div><div className="stat-trend up">Target: 90%</div></div>
        <div className="stat"><div className="stat-label">SLA breach</div><div className="stat-value">{slaBreaches}</div><div className="stat-trend down">Perlu eskalasi</div></div>
      </div>

      <div style={{ display:'grid', gridTemplateColumns:'2fr 1fr', gap:16, marginBottom:16 }}>
        <div className="card">
          <div className="card-header"><div className="card-title">Volume tiket — 7 hari terakhir</div><div className="card-subtitle">Total: {weeklyData.reduce((a,b)=>a+b.count,0)} tiket</div></div>
          <div className="card-body">
            <div style={{ display:'flex', alignItems:'flex-end', gap:12, height:180, paddingTop:20 }}>
              {weeklyData.map((d,i) => (
                <div key={i} style={{ flex:1, display:'flex', flexDirection:'column', alignItems:'center', gap:8 }}>
                  <div style={{ fontSize:11, color:'var(--text-muted)', fontWeight:500 }}>{d.count}</div>
                  <div style={{ width:'100%', height:`${(d.count/maxDay)*140}px`, background:'var(--accent)', borderRadius:'4px 4px 0 0' }}></div>
                  <div style={{ fontSize:11, color:'var(--text-muted)' }}>{d.day}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div className="card">
          <div className="card-header"><div className="card-title">CSAT Rating</div><div className="card-subtitle">Rata-rata kepuasan user</div></div>
          <div className="card-body" style={{ textAlign:'center', padding:'24px 20px' }}>
            <div style={{ fontSize:48, fontWeight:600, letterSpacing:'-0.03em', lineHeight:1 }}>4.6<span style={{ fontSize:24, color:'var(--text-muted)' }}>/5</span></div>
            <div style={{ fontSize:12, color:'var(--text-muted)', marginTop:8 }}>Dari 142 rating</div>
            <div style={{ marginTop:16, display:'flex', flexDirection:'column', gap:6 }}>
              {[5,4,3,2,1].map(n => (
                <div key={n} style={{ display:'flex', alignItems:'center', gap:8, fontSize:11 }}>
                  <span style={{ width:12 }}>{n}</span>
                  <div style={{ flex:1, height:6, background:'var(--surface-2)', borderRadius:3, overflow:'hidden' }}>
                    <div style={{ width: n===5?'72%':n===4?'20%':n===3?'5%':'2%', height:'100%', background:'var(--accent)' }}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="card">
        <div className="card-header"><div className="card-title">Volume per kategori</div></div>
        <div className="card-body">
          {categoryVolume.map(c => (
            <div key={c.id} style={{ marginBottom:12 }}>
              <div style={{ display:'flex', justifyContent:'space-between', fontSize:13, marginBottom:4 }}>
                <span style={{ fontWeight:500 }}>{c.name}</span><span className="mono" style={{ color:'var(--text-muted)' }}>{c.count}</span>
              </div>
              <div style={{ height:6, background:'var(--surface-2)', borderRadius:3, overflow:'hidden' }}>
                <div style={{ width:`${(c.count/maxVolume)*100}%`, height:'100%', background:'var(--accent)', borderRadius:3 }}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── REPORTING ─────────────────────────────────────────────────────────────────
function ReportingPage() {
  return (
    <div>
      <div className="filters">
        <select className="filter-select"><option>Bulan ini</option><option>Bulan lalu</option><option>3 bulan terakhir</option></select>
        <select className="filter-select"><option>Semua PIC</option>{pics.map(p => <option key={p.id}>{p.name}</option>)}</select>
        <button className="btn btn-secondary btn-sm">Apply</button>
      </div>
      <div className="stat-grid">
        <div className="stat"><div className="stat-label">Avg response time</div><div className="stat-value">12<span style={{ fontSize:14, color:'var(--text-muted)' }}> min</span></div><div className="stat-trend up">-3 min vs bulan lalu</div></div>
        <div className="stat"><div className="stat-label">Avg resolution time</div><div className="stat-value">3.2<span style={{ fontSize:14, color:'var(--text-muted)' }}> jam</span></div><div className="stat-trend">Stable</div></div>
        <div className="stat"><div className="stat-label">Reopen rate</div><div className="stat-value">4.1%</div><div className="stat-trend down">-1.2% vs bulan lalu</div></div>
        <div className="stat"><div className="stat-label">First-time resolution</div><div className="stat-value">87%</div><div className="stat-trend up">+2%</div></div>
      </div>
      <div className="card">
        <div className="card-header"><div className="card-title">Performa PIC</div><div className="card-subtitle">Bulan ini</div></div>
        <table className="table">
          <thead><tr><th>PIC</th><th>Tiket selesai</th><th>Avg resolution</th><th>SLA compliance</th><th>CSAT</th></tr></thead>
          <tbody>
            {pics.slice(0,4).map((p,i) => (
              <tr key={p.id}>
                <td><div style={{ display:'flex', alignItems:'center', gap:10 }}><div className="user-avatar" style={{ width:24, height:24, fontSize:10 }}>{p.initials}</div><div><div style={{ fontWeight:500 }}>{p.name}</div></div></div></td>
                <td>{[42,38,35,29][i]}</td>
                <td>{['2.8 jam','3.1 jam','2.4 jam','4.2 jam'][i]}</td>
                <td><span style={{ fontWeight:500, color: i===3?'var(--priority-medium)':'var(--status-done)' }}>{[96,94,98,88][i]}%</span></td>
                <td>{[4.7,4.5,4.8,4.3][i]} / 5</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

// ─── KB MANAGER ────────────────────────────────────────────────────────────────
function KBManagerPage() {
  const [showAdd, setShowAdd] = useState(false);
  return (
    <div>
      <div className="filters">
        <input className="filter-input" placeholder="Cari artikel..." />
        <select className="filter-select"><option>Semua kategori</option>{categories.map(c => <option key={c.id}>{c.name}</option>)}</select>
        <div style={{ marginLeft:'auto' }}><button className="btn btn-primary btn-sm" onClick={() => setShowAdd(true)}>+ Artikel Baru</button></div>
      </div>
      <div className="card">
        <table className="table">
          <thead><tr><th>Judul</th><th>Kategori</th><th>Views</th><th>Update terakhir</th><th></th></tr></thead>
          <tbody>
            {kbArticles.map(a => (
              <tr key={a.id}>
                <td style={{ fontWeight:500 }}>{a.title}</td>
                <td>{a.category}</td>
                <td className="mono" style={{ fontSize:12, color:'var(--text-muted)' }}>{a.views}</td>
                <td style={{ fontSize:12, color:'var(--text-muted)' }}>{formatDate(a.updated)}</td>
                <td><button className="btn btn-ghost btn-sm">Edit</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {showAdd && (
        <div className="modal-overlay" onClick={() => setShowAdd(false)}>
          <div className="modal" onClick={e => e.stopPropagation()}>
            <div className="modal-header"><div className="modal-title">Artikel Baru</div><button className="btn btn-ghost btn-sm" onClick={() => setShowAdd(false)}>Tutup</button></div>
            <div className="modal-body">
              <div className="field"><label className="label">Judul</label><input className="input" placeholder="Contoh: Cara reset password Outlook" /></div>
              <div className="field"><label className="label">Kategori</label><select className="select">{categories.map(c => <option key={c.id}>{c.name}</option>)}</select></div>
              <div className="field"><label className="label">Isi artikel</label><textarea className="textarea" placeholder="Tulis konten artikel..." style={{ minHeight:180 }} /></div>
            </div>
            <div className="modal-footer"><button className="btn btn-secondary" onClick={() => setShowAdd(false)}>Batal</button><button className="btn btn-primary">Publish</button></div>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── TICKET EDIT MODAL ─────────────────────────────────────────────────────────
function TicketEditModal({ ticket, onChange, onSave, onClose }: { ticket: Ticket; onChange: (fn: (t: Ticket) => Ticket) => void; onSave: (t: Ticket) => void; onClose: () => void }) {
  const set = (key: keyof Ticket) => (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const val = e.target.value;
    onChange(prev => {
      const next = { ...prev, [key]: val } as Ticket;
      if (key === 'assigneeTeamId') next.assignedToId = null;
      if (key === 'assignedToId') { const pic = pics.find(p => p.id === val); if (pic) next.assignedName = pic.name; }
      if (key === 'app') { const app = apps.find(a => a.name === val); if (app) next.category = app.prefix; }
      return next;
    });
  };
  const picOptions = ticket.assigneeTeamId ? pics.filter(p => p.teamId === ticket.assigneeTeamId) : pics;
  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal" style={{ maxWidth:620 }} onClick={e => e.stopPropagation()}>
        <div className="modal-header"><div><div className="modal-title">Edit Parameter Tiket</div><div style={{ fontSize:11, color:'var(--text-muted)', marginTop:2 }}>{ticket.id} · {ticket.subject}</div></div><button className="btn btn-ghost btn-sm" onClick={onClose}>✕</button></div>
        <div className="modal-body">
          <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:16 }}>
            <div className="field"><label className="label">Kategori</label><select className="select" value={ticket.category||''} onChange={set('category')}><option value="">— Pilih —</option>{categories.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}</select></div>
            <div className="field"><label className="label">Assignee Team</label><select className="select" value={ticket.assigneeTeamId||''} onChange={set('assigneeTeamId')}><option value="">— Pilih —</option>{teams.map(t => <option key={t.id} value={t.id}>{t.name}</option>)}</select></div>
            <div className="field"><label className="label">PIC</label><select className="select" value={ticket.assignedToId||''} onChange={set('assignedToId')}><option value="">— Pilih —</option>{picOptions.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}</select></div>
            <div className="field"><label className="label">Priority</label><select className="select" value={ticket.priority||'Medium'} onChange={set('priority')}>{['Low','Medium','High','Critical'].map(p => <option key={p} value={p}>{p}</option>)}</select></div>
            <div className="field"><label className="label">Status</label><select className="select" value={ticket.status||'Open'} onChange={set('status')}>{['Open','In Progress','Pending','Revisi','Done','Closed'].map(s => <option key={s} value={s}>{s}</option>)}</select></div>
            <div className="field"><label className="label">Application</label><select className="select" value={ticket.app||''} onChange={set('app')}><option value="">— Pilih —</option>{apps.map(a => <option key={a.name} value={a.name}>{a.name}</option>)}</select></div>
          </div>
          <div className="field"><label className="label">Specific Task</label><select className="select" value={ticket.specificTask||''} onChange={set('specificTask')}><option value="">— Pilih —</option>{specificTasks.map(t => <option key={t.name} value={t.name}>{t.name}</option>)}</select></div>
          <div className="field"><label className="label">Subject</label><input className="input" value={ticket.subject||''} onChange={set('subject')} /></div>
        </div>
        <div className="modal-footer"><button className="btn btn-secondary" onClick={onClose}>Batal</button><button className="btn btn-primary" onClick={() => onSave(ticket)}>Simpan Perubahan</button></div>
      </div>
    </div>
  );
}

// ─── ALL TICKETS ───────────────────────────────────────────────────────────────
function AllTicketsPage({ tickets, setTickets }: { tickets: Ticket[]; setTickets: React.Dispatch<React.SetStateAction<Ticket[]>> }) {
  const [editTarget, setEditTarget] = useState<Ticket | null>(null);
  const [search, setSearch] = useState('');
  const [filterStatus, setFilterStatus] = useState('');
  const [filterCat, setFilterCat] = useState('');
  const [filterPic, setFilterPic] = useState('');

  let visible = tickets;
  if (search.trim()) { const q = search.toLowerCase(); visible = visible.filter(t => t.subject.toLowerCase().includes(q)||t.id.toLowerCase().includes(q)||t.fromName.toLowerCase().includes(q)); }
  if (filterStatus) visible = visible.filter(t => t.status === filterStatus);
  if (filterCat) visible = visible.filter(t => t.category === filterCat);
  if (filterPic) visible = visible.filter(t => t.assignedToId === filterPic);

  const saveEdit = (updated: Ticket) => {
    const now = new Date().toISOString();
    const prev = tickets.find(t => t.id === updated.id);
    const statusChanged = prev?.status !== updated.status;
    const merged: Ticket = { ...updated, updatedAt: now, resolvedAt: (['Done','Closed'].includes(updated.status) && !updated.resolvedAt) ? now : updated.resolvedAt, activity: statusChanged ? [...(updated.activity||[]), { type:'system', time:now, text:`Status: ${prev?.status} → ${updated.status} (Manual Admin)` }] : updated.activity };
    ticketStore.update(merged.id, merged);
    setTickets(prev => prev.map(t => t.id === merged.id ? merged : t));
    setEditTarget(null);
  };

  const closeSingle = (id: string, e: React.MouseEvent) => {
    e.stopPropagation();
    const now = new Date().toISOString();
    const t = tickets.find(t => t.id === id);
    if (!t) return;
    const merged: Ticket = { ...t, status:'Closed', updatedAt:now, resolvedAt:t.resolvedAt||now, activity:[...(t.activity||[]),{ type:'system',time:now,text:`Status: ${t.status} → Closed (Manual Admin)` }] };
    ticketStore.update(id, merged);
    setTickets(prev => prev.map(x => x.id===id?merged:x));
  };

  return (
    <div>
      <div className="filters">
        <input className="filter-input" placeholder="Cari tiket..." value={search} onChange={e => setSearch(e.target.value)} />
        <select className="filter-select" value={filterStatus} onChange={e => setFilterStatus(e.target.value)}><option value="">Semua status</option>{['Open','In Progress','Pending','Revisi','Done','Closed'].map(s=><option key={s} value={s}>{s}</option>)}</select>
        <select className="filter-select" value={filterCat} onChange={e => setFilterCat(e.target.value)}><option value="">Semua kategori</option>{categories.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select>
        <select className="filter-select" value={filterPic} onChange={e => setFilterPic(e.target.value)}><option value="">Semua PIC</option>{pics.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select>
      </div>
      <div style={{ fontSize:12, color:'var(--text-muted)', marginBottom:8 }}>Klik baris untuk edit · {visible.length} tiket ditampilkan.</div>
      <div className="card">
        <table className="table">
          <thead><tr><th>ID</th><th>Subject</th><th>User</th><th>Kategori</th><th>Priority</th><th>Status</th><th>PIC</th><th>Tanggal</th><th>Aksi</th></tr></thead>
          <tbody>
            {visible.map(t => (
              <tr key={t.id} onClick={() => setEditTarget({ ...t })}>
                <td className="mono" style={{ fontSize:11, color:'var(--text-muted)' }}>{t.id}</td>
                <td style={{ fontWeight:500 }}>{t.subject}</td>
                <td style={{ fontSize:12 }}>{t.fromName}</td>
                <td style={{ fontSize:12 }}>{t.category}</td>
                <td><span className={`priority priority-${t.priority.toLowerCase()}`}><span className="priority-bar"></span>{t.priority}</span></td>
                <td><span className={`badge ${statusClass(t.status)}`}><span className="badge-dot"></span>{t.status}</span></td>
                <td style={{ fontSize:12 }}>{t.assignedName}</td>
                <td style={{ fontSize:12, color:'var(--text-muted)' }}>{formatDate(t.createdAt)}</td>
                <td onClick={e => e.stopPropagation()}>
                  {t.status !== 'Closed' && <button className="btn btn-secondary btn-sm" style={{ fontSize:11, padding:'2px 8px', whiteSpace:'nowrap' }} onClick={e => closeSingle(t.id, e)}>Tutup</button>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {editTarget && <TicketEditModal ticket={editTarget} onChange={fn => setEditTarget(prev => prev ? fn(prev) : prev)} onSave={saveEdit} onClose={() => setEditTarget(null)} />}
    </div>
  );
}

// ─── ROUTING RULES ────────────────────────────────────────────────────────────
const PAGE_SIZE = 15;

function RoutingRulesPage() {
  const [rules, setRules] = useState<AppPICRule[]>([]);
  const [search, setSearch] = useState('');
  const [editApp, setEditApp] = useState<string | null>(null);
  const [editPicId, setEditPicId] = useState('');
  const [page, setPage] = useState(1);

  useEffect(() => { setRules(appRulesStore.getAll()); }, []);

  // Reset ke page 1 saat search berubah
  useEffect(() => { setPage(1); }, [search]);

  const openEdit = (appName: string) => {
    const existing = rules.find(r => r.appName === appName);
    setEditPicId(existing?.picId ?? '');
    setEditApp(appName);
  };

  const saveRule = () => {
    if (!editApp) return;
    if (editPicId) appRulesStore.set(editApp, editPicId);
    else appRulesStore.remove(editApp);
    setRules(appRulesStore.getAll());
    setEditApp(null);
  };

  const removeRule = (appName: string) => {
    appRulesStore.remove(appName);
    setRules(appRulesStore.getAll());
  };

  const ruleMap = Object.fromEntries(rules.map(r => [r.appName, r.picId]));

  const filtered = apps.filter(a =>
    !search ||
    a.name.toLowerCase().includes(search.toLowerCase()) ||
    a.prefix.toLowerCase().includes(search.toLowerCase())
  );

  const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
  const paginated = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

  return (
    <div>
      {/* Toolbar */}
      <div style={{ marginBottom: 16, display: 'flex', alignItems: 'center', gap: 8, justifyContent: 'space-between', flexWrap: 'wrap' }}>
        <div style={{ fontSize: 13, color: 'var(--text-muted)' }}>
          PIC otomatis di-assign saat user memilih aplikasi tertentu.
          <span style={{ marginLeft: 8, fontWeight: 600, color: 'var(--text)' }}>{rules.length}/{apps.length} aplikasi sudah dikonfigurasi</span>
        </div>
        <input
          className="filter-input"
          placeholder="Cari aplikasi atau kategori..."
          value={search}
          onChange={e => setSearch(e.target.value)}
          style={{ width: 260 }}
        />
      </div>

      <div className="card">
        <table className="table">
          <thead>
            <tr>
              <th>Aplikasi</th>
              <th>Kategori</th>
              <th>PIC yang Ditugaskan</th>
              <th>Tim</th>
              <th style={{ width: 130 }}>Aksi</th>
            </tr>
          </thead>
          <tbody>
            {paginated.map(app => {
              const picId = ruleMap[app.name];
              const pic = picId ? pics.find(p => p.id === picId) : null;
              const team = pic ? teams.find(t => t.id === pic.teamId) : null;
              return (
                <tr key={app.name}>
                  <td style={{ fontWeight: 500 }}>{app.name}</td>
                  <td>
                    <span style={{ fontSize: 11, padding: '2px 6px', background: 'var(--surface-2)', borderRadius: 4, fontFamily: 'var(--mono)' }}>
                      {app.prefix}
                    </span>
                  </td>
                  <td>
                    {pic ? (
                      <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                        <div className="user-avatar" style={{ width: 22, height: 22, fontSize: 9 }}>{pic.initials}</div>
                        <span style={{ fontWeight: 500, color: 'var(--status-done)' }}>{pic.name}</span>
                      </div>
                    ) : (
                      <span style={{ fontSize: 12, color: 'var(--text-subtle)', fontStyle: 'italic' }}>Belum diatur</span>
                    )}
                  </td>
                  <td style={{ fontSize: 12, color: 'var(--text-muted)' }}>{team?.name ?? '—'}</td>
                  <td>
                    <div style={{ display: 'flex', gap: 4 }}>
                      <button className="btn btn-secondary btn-sm" onClick={() => openEdit(app.name)}>
                        {pic ? 'Ubah' : 'Set PIC'}
                      </button>
                      {pic && (
                        <button className="btn btn-ghost btn-sm" style={{ color: '#dc2626' }} onClick={() => removeRule(app.name)}>
                          Hapus
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        {/* Pagination */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '12px 16px', borderTop: '1px solid var(--border)' }}>
          <div style={{ fontSize: 12, color: 'var(--text-muted)' }}>
            {filtered.length === 0 ? 'Tidak ada hasil' : `${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, filtered.length)} dari ${filtered.length} aplikasi`}
          </div>
          <div style={{ display: 'flex', gap: 4, alignItems: 'center' }}>
            <button
              className="btn btn-secondary btn-sm"
              disabled={page === 1}
              onClick={() => setPage(p => p - 1)}
              style={{ minWidth: 32 }}
            >
              ‹
            </button>
            {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
              <button
                key={p}
                className={`btn btn-sm ${p === page ? 'btn-primary' : 'btn-secondary'}`}
                onClick={() => setPage(p)}
                style={{ minWidth: 32 }}
              >
                {p}
              </button>
            ))}
            <button
              className="btn btn-secondary btn-sm"
              disabled={page === totalPages || totalPages === 0}
              onClick={() => setPage(p => p + 1)}
              style={{ minWidth: 32 }}
            >
              ›
            </button>
          </div>
        </div>
      </div>

      {/* Edit modal */}
      {editApp !== null && (
        <div className="modal-overlay" onClick={() => setEditApp(null)}>
          <div className="modal" style={{ maxWidth: 420 }} onClick={e => e.stopPropagation()}>
            <div className="modal-header">
              <div>
                <div className="modal-title">Set PIC untuk Aplikasi</div>
                <div style={{ fontSize: 12, color: 'var(--text-muted)', marginTop: 2 }}>{editApp}</div>
              </div>
              <button className="btn btn-ghost btn-sm" onClick={() => setEditApp(null)}>✕</button>
            </div>
            <div className="modal-body">
              <div className="field">
                <label className="label">Pilih PIC</label>
                <select className="input" value={editPicId} onChange={e => setEditPicId(e.target.value)}>
                  <option value="">— Tidak ada / Hapus rule —</option>
                  {teams.map(t => (
                    <optgroup key={t.id} label={t.name}>
                      {pics.filter(p => p.teamId === t.id).map(p => (
                        <option key={p.id} value={p.id}>{p.name}{p.isHead ? ' (Head)' : ''}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <div className="field-hint">Kosongkan untuk menghapus rule — tiket akan masuk Unassigned</div>
              </div>
              {editPicId && (() => {
                const p = pics.find(x => x.id === editPicId);
                const t = p ? teams.find(x => x.id === p.teamId) : null;
                return p ? (
                  <div style={{ padding: 10, background: 'var(--surface-2)', borderRadius: 6, fontSize: 12 }}>
                    <span style={{ color: 'var(--text-muted)' }}>Preview: </span>
                    <strong>{p.name}</strong> dari <strong>{t?.name}</strong>
                  </div>
                ) : null;
              })()}
            </div>
            <div className="modal-footer">
              <button className="btn btn-secondary" onClick={() => setEditApp(null)}>Batal</button>
              <button className="btn btn-primary" onClick={saveRule}>Simpan</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

